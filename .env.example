# Copy to .env.local and fill in. Only VITE_ variables reach the browser.
# The account service (Supabase). The publishable (anon) key is made for the browser; the service role key is NOT —
# it never goes in a VITE_ variable, this repo, or a chat.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Stripe. The publishable key is made for the browser; the secret key and the webhook signing secret are Edge Function
# secrets in the Supabase project (its dashboard), never VITE_ variables.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# The visit count (Plausible, cookieless — core/analytics.ts). Name the site and the script loads; leave it blank and
# nothing is counted. Blank in development and on every build before the domain exists; the privacy page follows it.
VITE_PLAUSIBLE_DOMAIN=

# THE DATA FEED (docs/data-feed.md). These go in .env at the repo root (git-ignored) and NEVER with a VITE_ prefix: a
# VITE_ variable is written into the browser bundle. The dev server and `npm run serve` read them and add them to the
# vendor calls themselves (server/feed.ts); the page never sees a key. Restart after a change; `npm run feed:check`
# says whether they work.

# Unusual Whales — sent as "Authorization: Bearer …"
UW_API_TOKEN=

# Massive (Polygon) — sent as the apiKey parameter
MASSIVE_API_KEY=

# The proxy answers this machine alone unless this is 1 — a deployed server must put its own sign-in in front of
# /feed/* before opening it, or the key is anyone's to use
FEED_ALLOW_LAN=
