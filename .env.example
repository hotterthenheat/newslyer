# Copy to .env.local and fill in. Only VITE_ variables reach the browser.
# The account service (Supabase). The publishable (anon) key is made for the browser; the service role key is NOT —
# it never goes in a VITE_ variable, this repo, or a chat.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Stripe. The publishable key is made for the browser; the secret key and the webhook signing secret are Edge Function
# secrets in the Supabase project (its dashboard), never VITE_ variables.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# The visit count (Plausible, cookieless — core/analytics.ts). Name the site and the script loads; leave it blank and
# nothing is counted. Blank in development and on every build before the domain exists; the privacy page follows it.
VITE_PLAUSIBLE_DOMAIN=
